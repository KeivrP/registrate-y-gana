# Postgres (Neon). Al conectar Neon desde Vercel → Storage, esta variable se crea sola.
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# PIN para entrar a /admin (usa 6+ dígitos)
ADMIN_PIN=123456

# Opcional: secreto para firmar la sesión del admin (cualquier texto largo)
SESSION_SECRET=
